  body: none
  auth: none
}

headers {
  Cookie: {{cookie}}
}

tests {
  test("200 を返す", function () {
    expect(res.status).to.equal(200);
  });
  
  test("ログインしていない状態になる", function () {
    expect(res.body).to.equal(null);
  });
}
