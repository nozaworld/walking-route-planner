meta {
  name: いいねする
  type: http
  seq: 12
}

docs {
  いいねを付けると，いいね数が1になる．
}

post {
  url: {{baseUrl}}/api/routes/{{routeId}}/like
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{baseUrl}}
  Cookie: {{cookie}}
}

tests {
  test("200 を返す", function () {
    expect(res.status).to.equal(200);
  });
  
  test("いいね数が1になる", function () {
    expect(res.body.liked).to.equal(true);
    expect(res.body.likeCount).to.equal(1);
  });
}
