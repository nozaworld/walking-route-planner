meta {
  name: 間違ったパスワード
  type: http
  seq: 3
}

docs {
  パスワードが違えば 401．
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{baseUrl}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "wrong-password"
  }
}

tests {
  test("401 を返す", function () {
    expect(res.status).to.equal(401);
  });
}
