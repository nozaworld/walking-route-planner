docs {
  地図の中心を名古屋にして検索する（ORS の利用回数を2回使う）．
}

get {
  url: {{baseUrl}}/api/geocode?q=名古屋城&lat=35.18&lng=136.91
  body: none
  auth: none
}

tests {
