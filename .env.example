# OpenRouteService の API キー（https://openrouteservice.org/ でアカウントを作ると無料で取得できる）
# サーバー側でのみ使うので NEXT_PUBLIC_ を付けないこと
ORS_API_KEY=

# Postgres（Neon）の接続先．アプリはプーリング経由，マイグレーションは直接の接続を使う
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ログイン（better-auth）．秘密鍵は `openssl rand -base64 32` などで作る
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
